# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # keep secret, server-only

# ---------- Owner panel login (/admin) ----------
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=any-long-random-string

# ---------- Owner email alerts ----------
# Sender mailbox: a Gmail account + its 16-letter App Password
# (Google Account → Security → 2-Step Verification ON → App passwords)
SMTP_USER=yourshop@gmail.com
SMTP_PASS=abcdefghijklmnop
# Optional (defaults shown) — only change if you use a different mail provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---------- Public site URL (used in email links) ----------
NEXT_PUBLIC_SITE_URL=https://www.soamijienterprises.in
